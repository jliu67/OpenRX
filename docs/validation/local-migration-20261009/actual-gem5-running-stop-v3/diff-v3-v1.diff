+def newbytes(path, value):
+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+    with os.fdopen(fd, 'wb') as out:
+        out.write(value)
+        out.flush()
+        os.fsync(out.fileno())
+    syncdir(path.parent)
+
+
+def running_guest_stage(directory, pidfd):
+    """Require actual expected firmware serial while the same pinned process lives."""
+    output = directory / 'payload/m5out'
+    if not output.exists():
+        return None, None
+    require(not output.is_symlink(), 'Simulator output directory is linked')
+    terminals = list(output.glob('*terminal*'))
+    require(len(terminals) <= 1, 'Ambiguous firmware serial logs')
+    if not terminals:
+        return None, None
+    path = terminals[0]
+    require(path.name == 'board.platform.terminal' and not path.is_symlink(),
+            'Unexpected firmware serial path')
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    try:
+        require(stat.S_ISREG(os.fstat(fd).st_mode), 'Firmware serial is not regular')
+        serial = os.read(fd, 256 * 1024 + 1)
+    finally:
+        os.close(fd)
+    require(len(serial) <= 256 * 1024, 'Firmware serial exceeds declared bounded inspection')
+    if not serial.startswith(b'\r\nOpenSBI v1.3.1\r\n') or b'Platform HART Count       : 1\r\n' not in serial:
+        return None, None
+    poller = select.poll()
+    poller.register(pidfd, select.POLLIN)
+    if poller.poll(0):
+        return None, None
+    return serial, {'stage': 'expected-open-sbi-firmware-executing',
+                    'terminal_path': str(path), 'bytes': len(serial),
+                    'sha256': hashlib.sha256(serial).hexdigest(),
+                    'required_banner': 'OpenSBI v1.3.1', 'required_harts': 1,
+                    'same_pinned_process_pidfd_still_live': True,
+                    'utc': datetime.datetime.now(datetime.timezone.utc).isoformat()}
 
 

+        require(ROOT.is_dir() and not ROOT.is_symlink(), 'Unsafe or missing isolated fixture root')
+        require(namespace.is_dir() and not namespace.is_symlink(), 'Unsafe or missing fixture execution namespace')
+        candidates.update(path.name for path in namespace.iterdir())
+    except BaseException as exc:
+        records.append({'discovery_error': repr(exc), 'path': str(namespace),
+                        'instruction': 'Preserve partial directories; do not infer absent service or replay.'})
+    for eid in sorted(candidates):
+        try:
+            require(bool(runner.ID_RE.fullmatch(eid)), 'Partial entry is not a valid execution ID')
+            directory = runner.execution_dir(ROOT, eid)
+            manifest = readjson(directory / 'manifest.json')
+            unit = 'openrx-' + eid + '.service'
+            require(manifest.get('execution_id') == eid and manifest.get('unit') == unit,
+                    'Partial manifest does not bind its exact derived unit name')
+            require(manifest.get('request_key') in {
+                'final988-stop-detached', 'final988-instant-0', 'final988-instant-1',
+                'final988-instant-2', 'final988-exit-seven', 'final988-worker-killed',
+                'final988-oom', 'final988-independent-launcher', 'final988-serialize-first',
+                'final988-serialize-second'}, 'Partial manifest does not match a fixed fixture request')
+            require(manifest.get('resource_lock') == str(ROOT / 'locks' / 'execution.lock')
+                    and manifest.get('runner', {}).get('sha256') == RUNNER_SHA,
+                    'Partial manifest is outside the fixture root/release')
+            if (directory / 'receipt.json').exists():
+                records.append({'execution_id': eid, 'receipt_present': True,
+                                'instruction': 'Preserve finalized evidence; inspect/verify separately.'})
+                continue
+            # The external failure receipt records this stop. Avoid appending
+            # an execution event that could race its concurrent final receipt.
+            # The exact derived unit is used, never arbitrary manifest text.
+            stopped = command(['systemctl', '--user', 'stop', unit])
